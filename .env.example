# ==============================================================================
# Environment Configuration Template
# Advanced QR Code Payment Fraud Detection System
# ==============================================================================

# Application & Runtime
ENVIRONMENT=development
DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change_this_to_a_secure_random_hex_key_in_production
PII_SECRET_SALT=secure_random_salt_for_payer_id_hashing_2026

# Database Persistence (SQLite Default WAL Mode)
DATABASE_URL=sqlite:///./database/fraud_detection.db
SQL_ECHO=false

# Caching & Velocity Store (memory | redis)
CACHE_BACKEND=memory
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Model Gating & Policy Thresholds
WEIGHT_SUPERVISED=0.70
WEIGHT_ANOMALY=0.30
THRESHOLD_APPROVE=0.30
THRESHOLD_BLOCK=0.70
ZERO_DAY_ANOMALY_ESCALATION=0.80

# Latency & Circuit Breaker Watchdog
TIMEOUT_CIRCUIT_BREAKER_MS=120
SELECTIVE_SHAP_OPTIMIZATION=true

# Logging
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs/application.log


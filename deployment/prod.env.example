# ==============================================================================
# Production Environment Variables Example
# Copy to .env in production deployment and populate secure secrets.
# NEVER commit the active .env file to version control!
# ==============================================================================

# Application & Environment
PROJECT_NAME="Advanced QR Code Payment Fraud Detection System"
VERSION="1.0.0"
ENVIRONMENT="production"
DEBUG=False
APP_HOST="0.0.0.0"
APP_PORT=8000

# Cryptographic Keys (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY="REPLACE_WITH_A_SECURE_64_CHAR_HEX_SECRET_KEY_FOR_HMAC_SIGNATURES"
PII_SECRET_SALT="REPLACE_WITH_A_UNIQUE_64_CHAR_SALT_FOR_CUSTOMER_IDENTIFIERS"

# Database Configuration (SQLite WAL mode or PostgreSQL)
DATABASE_URL="sqlite:///database/fraud_detection.db"
SQL_ECHO=False

# State Caching Layer
CACHE_BACKEND="memory"
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0

# Detection Weights & Three-Tier Gating Thresholds
WEIGHT_SUPERVISED=0.70
WEIGHT_ANOMALY=0.30
THRESHOLD_APPROVE=0.30
THRESHOLD_BLOCK=0.70
ZERO_DAY_ANOMALY_ESCALATION=0.80

# Latency Budget & XAI Optimization
TIMEOUT_CIRCUIT_BREAKER_MS=120
SELECTIVE_SHAP_OPTIMIZATION=True

# Centralized Logging
LOG_LEVEL="INFO"
LOG_FILE_PATH="logs/application.log"

